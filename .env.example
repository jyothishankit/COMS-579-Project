# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-proj-...

# Root of the LegalBench-RAG download (must contain ./corpus and ./benchmarks).
LEGALBENCH_DIR=../LegalBench-RAG

# pinecone | numpy
VECTOR_BACKEND=pinecone

# Pinecone Local (docker compose up -d pinecone) uses the literal key "pclocal".
# For Pinecone cloud, set a real key and leave PINECONE_LOCAL_HOST empty.
PINECONE_API_KEY=pclocal
PINECONE_LOCAL_HOST=http://localhost:5080
